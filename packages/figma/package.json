{
  "name": "@worldbend/figma",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build --config vite.config.ts --mode ui",
    "build:main": "vite build --config vite.config.ts --mode main",
    "build:entries": "pnpm build:ui && pnpm build:main",
    "build": "pnpm --workspace-root build:web && pnpm --workspace-root build:figma:entries",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@worldbend/web": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.134.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  }
}
