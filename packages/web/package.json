      "types": "./dist/perspective.d.ts",
      "import": "./dist/perspective.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js"
    },
    "./surface-window": {
      "types": "./dist/surface-window.d.ts",
      "import": "./dist/surface-window.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "import": "./dist/appearance.js"
