    "./appearance-receiving": {
      "types": "./dist/appearance-receiving.d.ts",
      "import": "./dist/appearance-receiving.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./card-state": {
      "types": "./dist/card-state.d.ts",
      "import": "./dist/card-state.js"
    },
    "./card": {
      "types": "./dist/card-entry.d.ts",
      "import": "./dist/card.js"
    },
    "./foil": {
      "types": "./dist/foil.d.ts",
      "import": "./dist/foil.js"
