{
  "name": "@worldbend/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./material-preference": {
      "types": "./dist/material-preference.d.ts",
      "import": "./dist/material-preference.js"
    },
    "./mockup-motion": {
      "types": "./dist/mockup-motion.d.ts",
      "import": "./dist/mockup-motion.js"
    },
