{
  "name": "@worldbend/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./perspective": {
      "types": "./dist/perspective.d.ts",
      "import": "./dist/perspective.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && vite build --config vite.demo.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@worldbend/wasm": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
